{
  "expo": {
    "name": "Bazarpeth",
    "slug": "jhat-pat-mobile-app",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/bazarpeth_app_icon_dark_1024x1024.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/bazarpeth_icon_card_light_bg.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true
    },
    "scheme": "bazarpeth",
    "android": {
      "package": "com.bazarpeth.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/bazarpeth_favicon_32x32.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "8884256b-61fa-4e24-8287-6bca7730c63a"
      }
    },
    "owner": "vibecoderswaroop",
    "updates": {
      "url": "https://u.expo.dev/8884256b-61fa-4e24-8287-6bca7730c63a"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/bazarpeth_icon_card_light_bg.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "./proguard-rules.pro"
          }
        }
      ],
      "expo-image",
      "expo-video",
      "./plugins/withKotlinJvmTarget"
    ]
  }
}
